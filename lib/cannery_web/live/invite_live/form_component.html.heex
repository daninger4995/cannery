<div>
  <h2 class="mb-8 text-center title text-xl text-primary-600 dark:text-white">
    {@title}
  </h2>
  <.simple_form
    :let={f}
    for={@changeset}
    id="invite-form"
    class="flex flex-col space-y-4 justify-center items-stretch max-w-2xl w-full mx-auto"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
  >
    <.input
      field={f[:name]}
      type="text"
      label={gettext("Name")}
      class="input input-primary"
      maxlength="255"
      phx-debounce="300"
    />

    <.input
      field={f[:uses_left]}
      type="number"
      label={gettext("Uses left")}
      min="0"
      class="input input-primary"
    />
    <span class="text-primary-400 italic text-center">
      {gettext(~s/Leave "Uses left" blank to make invite unlimited/)}
    </span>

    <:actions>
      <.button
        class="mx-auto btn btn-primary"
        phx-disable-with={dgettext("prompts", "Saving…")}
      >
        {dgettext("actions", "Save")}
      </.button>
    </:actions>
  </.simple_form>
</div>
