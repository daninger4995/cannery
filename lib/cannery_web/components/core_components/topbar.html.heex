<nav
  role="navigation"
  class="mb-8 px-8 py-4 w-full bg-primary-500 dark:bg-surface-dark transition-[background-color] duration-500 ease-in-out"
>
  <div class="flex flex-col sm:flex-row justify-between items-center">
    <div class="mb-4 sm:mb-0 sm:mr-8 flex flex-row justify-start items-center space-x-2">
      <.link navigate={~p"/"} class="inline mx-2 my-1 leading-5 text-xl text-white">
        <img
          src={~p"/images/cannery.svg"}
          alt={gettext("Cannery logo")}
          class="inline-block h-8 mx-1 align-middle"
        />
        <h1 class="inline align-middle hover:underline">Cannery</h1>
      </.link>

      <%= if @title_content do %>
        <span class="mx-2 my-1">
          |
        </span>
        {@title_content}
      <% end %>
    </div>

    <hr class="mb-2 sm:hidden hr-light" />

    <ul class="flex flex-row flex-wrap justify-center items-center
      text-lg text-white text-ellipsis">
      <%= if @current_user do %>
        <li class="mx-2 my-1">
          <.link navigate={~p"/tags"} class="text-white hover:underline">
            {gettext("Tags")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link navigate={~p"/containers"} class="text-white hover:underline">
            {gettext("Containers")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link navigate={~p"/catalog"} class="text-white hover:underline">
            {gettext("Catalog")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link navigate={~p"/ammo"} class="text-white hover:underline">
            {gettext("Ammo")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link navigate={~p"/range"} class="text-white hover:underline">
            {gettext("Range")}
          </.link>
        </li>
        <li :if={@current_user |> Accounts.already_admin?()} class="mx-2 my-1">
          <.link navigate={~p"/invites"} class="text-white hover:underline">
            {gettext("Invites")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link href={~p"/users/settings"} class="text-white hover:underline truncate">
            {@current_user.email}
          </.link>
        </li>
        <li class="mx-2 my-1 self-stretch flex items-center" aria-hidden="true">
          <span class="block w-px h-6 bg-white/50"></span>
        </li>
        <li class="mx-2 my-1" id="theme-toggle-wrapper" phx-update="ignore">
          <button
            id="theme-toggle"
            phx-hook=".ThemeToggle"
            type="button"
            class="flex items-center text-white cursor-pointer transition-all duration-300 ease-in-out"
            aria-label={gettext("Toggle dark mode")}
          >
            <.icon name="sun" data-theme-icon="dark" class="size-6" style="display:none" />
            <.icon name="moon" data-theme-icon="light" class="size-6" style="display:none" />
          </button>
        </li>
        <script :type={ColocatedHook} name=".ThemeToggle">
          function getStoredTheme() {
            return localStorage.getItem('theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          }

          function applyThemeIcons(theme) {
            document.querySelectorAll('[data-theme-icon]').forEach(el => {
              el.style.display = el.dataset.themeIcon === theme ? '' : 'none'
            })
          }

          export default {
            mounted() {
              applyThemeIcons(getStoredTheme())
              this.el.addEventListener('click', () => {
                const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
                localStorage.setItem('theme', next)
                if (next === 'dark') {
                  document.documentElement.classList.add('dark')
                } else {
                  document.documentElement.classList.remove('dark')
                }
                applyThemeIcons(next)
              })
            }
          }
        </script>
        <li class="mx-2 my-1">
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-white hover:underline"
            data-confirm={dgettext("prompts", "Are you sure you want to log out?")}
            aria-label={gettext("Log out")}
          >
            <.icon name="arrow-right-start-on-rectangle" class="size-6" />
          </.link>
        </li>
        <li
          :if={@current_user.role == :admin}
          class="mx-2 my-1"
        >
          <.link
            navigate={~p"/dashboard"}
            class="text-white hover:underline"
            aria-label={gettext("Live Dashboard")}
          >
            <.icon name="cpu-chip" class="size-6" />
          </.link>
        </li>
      <% else %>
        <li :if={Accounts.allow_registration?()} class="mx-2 my-1">
          <.link href={~p"/users/register"} class="text-white hover:underline truncate">
            {dgettext("actions", "Register")}
          </.link>
        </li>
        <li class="mx-2 my-1">
          <.link href={~p"/users/log_in"} class="text-white hover:underline truncate">
            {dgettext("actions", "Log in")}
          </.link>
        </li>
      <% end %>
    </ul>
  </div>
</nav>
