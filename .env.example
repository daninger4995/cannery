# App endpoint configuration
HOST=localhost
PORT=4000
LOCALE=en_US
REGISTRATION=invite

# Generate with:
# openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=replace-with-random-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cannery
DATABASE_URL=ecto://postgres:postgres@cannery-db/cannery

# SMTP (required in production runtime)
SMTP_HOST=smtp.mailserver.tld
SMTP_PORT=587
SMTP_USERNAME=username
SMTP_PASSWORD=change-me
SMTP_SSL=false

# Optional email sender overrides
# EMAIL_FROM=no-reply@example.com
# EMAIL_NAME=Cannery
